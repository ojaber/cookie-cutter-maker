# Optional: enables the "From text" tab (prompt -> outline via OpenAI Images API)
OPENAI_API_KEY=

# Optional: require a passphrase to use the app (leave empty for a public/open site)
ACCESS_PASSWORD=
# Required for stable login sessions when ACCESS_PASSWORD is set (any long random string)
SESSION_SECRET=

# Public-instance guards — heavy pipeline requests per client IP per minute,
# and how many pipeline jobs may run at once. 0 disables either guard.
RATE_LIMIT_PER_MINUTE=20
HEAVY_CONCURRENCY=2

# Who may embed the app in an iframe (CSP frame-ancestors). Auto-set when
# running on a Hugging Face Space; usually leave empty.
FRAME_ANCESTORS=
